{% raw %}

/* ---------------------------------------------------------------- reset */

*, *::before, *::after { box-sizing: border-box; }
* { margin: 0; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: var(--s6); }
img, svg, video { display: block; max-width: 100%; height: auto; }
button, input, select, textarea { font: inherit; color: inherit; }
ul, ol { list-style: none; padding: 0; }

body {
  background: var(--ground);
  color: var(--ink);
  font-family: var(--sans);
  font-size: var(--t-body);
  line-height: var(--lh-prose);
  font-synthesis-weight: none;
  text-rendering: optimizeLegibility;
}

/* One focus treatment for the whole site, on the accent so it reads as state. */
:focus-visible {
  outline: 2px solid var(--accent-ink);
  outline-offset: 3px;
  border-radius: 1px;
}

::selection { background: var(--accent); color: var(--on-accent); }

/* Component display rules outrank the UA stylesheet, so [hidden] has to win
   explicitly. */
[hidden] { display: none !important; }

/* Controls that cannot work without a script. They ship in the markup and are
   removed here instead, because the class is set before the first paint: doing
   it the other way round meant the deferred script drew them in afterwards, and
   they arrived late and pushed what was already on screen. */
.no-js .scheme,
.no-js .search__key,
.no-js .totop,
.no-js .page-search,
.no-js .rail__toggle,
.no-js .rail__backdrop,
.no-js .cards-expandable__action,
.no-js [data-print] { display: none !important; }
.no-js .collapsible-drawer { display: block !important; grid-template-rows: 1fr !important; opacity: 1 !important; }
.no-js .rail__menu { display: block !important; position: static !important; }
.no-js .rail__menu-inner { display: flex !important; flex-direction: column !important; overflow: visible !important; max-height: none !important; }

/* Same reasoning for the shortcut itself: both labels ship and the one that
   applies is chosen by a class the same script sets. */
.search__key--mac { display: none; }
.is-mac .search__key--mac { display: inline; }
.is-mac .search__key--std { display: none; }

.u-hidden {
  position: absolute; width: 1px; height: 1px;
  padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
}

.skip {
  position: absolute; left: var(--s4); top: -4rem; z-index: 10;
  padding: var(--s2) var(--s4);
  background: var(--ink); color: var(--ground);
  font-family: var(--mono); font-size: var(--t-mono); text-decoration: none;
  transition: top var(--fast) var(--ease);
}
.skip:focus { top: var(--s4); }

/* --------------------------------------------------------------- layout */

/* Two zones sit in a narrower shell so the composition stays centred instead of
   hugging the left edge. Only a page with a margin column claims the full width.

   The shell is at least a viewport tall and the main column fills it, so a short
   page still puts its footer at the bottom rather than partway up the screen. */
.shell {
  max-width: var(--shell);
  min-height: 100dvh;
  margin-inline: auto;
  padding-inline: var(--pad-x);
  display: flex;
  flex-direction: column;
}
.page--split .shell { max-width: var(--shell-wide); }

@media (min-width: 60rem) {
  .shell {
    display: grid;
    grid-template-columns: var(--rail-w) minmax(0, 1fr);
    /* Stretch rather than start, so the main column reaches the full height.
       The rail sets its own height, so stretching does not affect it. */
    align-items: stretch;
  }
}

.main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  flex: 1 0 auto;
  padding-block: var(--s6) 0;
}
@media (min-width: 60rem) {
  .main { padding: var(--s7) 0 0 var(--s6); }
}

/* Grows to absorb spare height, which is what pushes the footer down on a short
   page. The footer keeps its own margin, so long and short pages look the same. */
.page {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--s7);
  flex: 1 0 auto;
  align-content: start;
  width: 100%;
}
.page__body {
  min-width: 0;
  width: 100%;
  animation: page-fade-in var(--slow) var(--ease) both;
}
@keyframes page-fade-in {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (min-width: 60rem) {
  .page {
    grid-template-columns: minmax(0, var(--measure));
  }
}

/* The third zone only exists when all three fit at their real widths. */
@media (min-width: 72rem) {
  .page--split {
    grid-template-columns: minmax(0, var(--measure)) var(--aside-w);
    column-gap: var(--gutter);
    align-items: start;
  }
  .page--split .page__aside { position: sticky; top: var(--s7); }
}

/* ----------------------------------------------------------------- rail */

.rail {
  padding-block: var(--s5);
  border-bottom: 1px solid var(--rule);
}

@media (min-width: 60rem) {
  .rail {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    /* A tall rail has to scroll, but overflow-y forces overflow-x to clip with
       it, and the items sit flush against that edge. The gutter gives the focus
       ring and the current-page marker somewhere to be drawn; the matching
       negative margin puts the rail back where it was. */
    padding: var(--s7) var(--s5) var(--s6) var(--s4);
    margin-left: calc(var(--s4) * -1);
    border-bottom: 0;
    border-right: 1px solid var(--rule);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .rail__bar { display: contents; }
  .rail__toggle { display: none !important; }
  .rail__menu { display: contents; }
  .rail__menu-inner { display: contents; }
  .rail__backdrop { display: none !important; }
  .rail__spacer { flex: 1 1 auto; min-height: var(--s6); }
}

/* The handle is the mark in the rail. Mono, because it is an identifier. */
.identity {
  display: block;
  font-family: var(--mono);
  font-size: var(--t-h3);
  font-weight: 500;
  letter-spacing: -0.01em;
  color: var(--ink);
  text-decoration: none;
  transition: color var(--fast) var(--ease), transform var(--fast) var(--ease);
}
.identity__at { color: var(--ink-3); transition: color var(--fast) var(--ease); }
.identity:hover { color: var(--accent-ink); transform: translateX(1.5px); }
.identity:hover .identity__at { color: var(--accent); }

/* Navigation. The count column is real data, set in tabular mono so the
   figures line up down the rail. */
.nav { display: flex; gap: var(--s5); overflow-x: auto; }
.nav__item {
  position: relative;
  display: flex;
  align-items: baseline;
  gap: var(--s2);
  padding-block: var(--s2);
  font-family: var(--mono);
  font-size: var(--t-mono);
  color: var(--ink-2);
  text-decoration: none;
  white-space: nowrap;
  border-radius: 2px;
  transition: color var(--fast) var(--ease), background var(--fast) var(--ease);
}
.nav__item:hover { color: var(--ink); }
@media (min-width: 60rem) {
  .nav__item {
    transition: color var(--fast) var(--ease),
                background var(--fast) var(--ease),
                transform var(--fast) var(--ease),
                padding-left var(--fast) var(--ease);
  }
  .nav__item:hover {
    transform: translateX(2.5px);
    background: color-mix(in srgb, var(--ink) 3.5%, transparent);
  }
  .nav__item:active { transform: translateX(2.5px) translateY(var(--press)); }
}
.nav__item[aria-current] { color: var(--ink); font-weight: 500; }
.nav__count {
  font-size: var(--t-mono-s);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
  transition: color var(--fast) var(--ease), transform var(--fast) var(--ease);
}
.nav__item:hover .nav__count {
  color: var(--accent-ink);
  transform: scale(1.06);
}

@media (min-width: 60rem) {
  .nav { flex-direction: column; gap: 0; overflow: visible; }
  .nav__item { justify-content: space-between; padding-block: 0.35rem; padding-inline: 0.35rem; }
  .nav__item[aria-current]::before {
    content: '';
    position: absolute;
    left: -0.75rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--accent);
    transition: top var(--slow) var(--ease), bottom var(--slow) var(--ease);
  }
}
@media (max-width: 59.99rem) {
  .nav__item[aria-current]::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: var(--accent);
    transition: opacity var(--fast) var(--ease);
  }
}

.search {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s3);
  padding: var(--s2) var(--s3);
  border: 1px solid var(--rule-strong);
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  color: var(--ink-2);
  text-decoration: none;
  background: transparent;
  transition: border-color var(--fast) var(--ease),
              color var(--fast) var(--ease),
              background var(--fast) var(--ease),
              transform var(--fast) var(--ease),
              box-shadow var(--fast) var(--ease);
}
.search:hover {
  border-color: var(--ink-3);
  color: var(--ink);
  background: var(--sunken);
  transform: translateY(-1px);
  box-shadow: 0 2px 5px -1px color-mix(in srgb, var(--ink) 6%, transparent);
}
.search:active {
  transform: translateY(var(--press));
  box-shadow: none;
}
.search kbd {
  font-family: inherit;
  font-size: var(--t-label);
  padding: 0 0.3rem;
  border: 1px solid var(--rule);
  color: var(--ink-3);
  background: transparent;
  transition: border-color var(--fast) var(--ease),
              color var(--fast) var(--ease),
              background var(--fast) var(--ease);
}
.search:hover kbd {
  border-color: var(--ink-3);
  color: var(--ink);
  background: var(--ground);
}

/* --------------------------------------------------- unified links & social */

.links-list,
.social {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s3);
  list-style: none;
  padding: 0;
  margin: 0;
}
.links-list__item {
  display: inline-flex;
  align-items: center;
}
.links-list--buttons {
  gap: var(--s2) var(--s3);
}

.link-item,
.social a {
  display: inline-flex;
  align-items: center;
  gap: 0.55em;
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  color: var(--ink-2);
  text-decoration: none;
  transition: color var(--fast) var(--ease),
              transform var(--fast) var(--ease);
}
.link-item:hover,
.social a:hover {
  color: var(--accent-ink);
  transform: translateX(2px);
}
.link-item:active,
.social a:active {
  transform: translateX(2px) translateY(var(--press));
}

/* Unified symbolic icon presentation for links, buttons, and social */
.icon-glyph,
.social svg,
.link-item svg,
.btn > svg:not(.ui-arrow) {
  display: inline-block;
  flex: none;
  width: 1.15em;
  height: 1.15em;
  fill: currentColor;
  vertical-align: -0.15em;
  transition: transform var(--fast) var(--ease);
}
.social svg path,
.social svg circle,
.social svg rect,
.social svg polygon,
.link-item svg path,
.link-item svg circle,
.link-item svg rect,
.link-item svg polygon,
.btn > svg:not(.ui-arrow) path,
.btn > svg:not(.ui-arrow) circle,
.btn > svg:not(.ui-arrow) rect,
.btn > svg:not(.ui-arrow) polygon {
  fill: currentColor;
}
.social__icon {
  display: inline-block;
  flex: none;
  width: 1.15em;
  height: 1.15em;
  background-color: currentColor;
  -webkit-mask: var(--icon) no-repeat center / contain;
  mask: var(--icon) no-repeat center / contain;
  vertical-align: -0.15em;
  transition: transform var(--fast) var(--ease);
}
.link-item:hover svg,
.link-item:hover .social__icon,
.social a:hover svg,
.social a:hover .social__icon,
.btn:hover > svg:not(.ui-arrow),
.btn:hover > .social__icon {
  transform: scale(1.1);
}
.social__mark {
  display: inline-flex;
  flex: none;
  width: 1.15em;
  height: 1.15em;
  vertical-align: -0.15em;
}
.social__mark img,
.social__mark svg {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
@media (min-width: 60rem) {
  .social { flex-direction: column; gap: var(--s1); }
}

/* --at is set from data-theme here, not by the script, so it's already correct
   pre-paint and never animates on load. Order must match schemeStages in rail.njk. */
:root { --at: 0; }
:root[data-theme='light'] { --at: 1; }
:root[data-theme='dark'] { --at: 2; }

/* Segmented scheme control: a floating thumb over equal cells, on the same
   inset padding it's sized against so the two can't drift apart. */
.scheme {
  --stages: 3;
  --inset: 3px;
  position: relative;
  display: grid;
  grid-template-columns: repeat(var(--stages), 1fr);
  width: max-content;
  padding: var(--inset);
  background: var(--sunken);
  border: 1px solid var(--rule-strong);
  isolation: isolate;
}
.scheme::before {
  content: '';
  position: absolute;
  z-index: -1;
  top: var(--inset);
  bottom: var(--inset);
  left: var(--inset);
  width: calc((100% - 2 * var(--inset)) / var(--stages));
  background: var(--ground);
  border: 1px solid var(--rule-strong);
  border-radius: 1px;
  box-shadow: 0 1px 3px color-mix(in srgb, var(--ink) 5%, transparent);
  transform: translateX(calc(var(--at, 0) * 100%));
  transition: transform var(--slow) var(--ease-spring);
}
.scheme__btn {
  /* Right padding trimmed by the letter-spacing trailing gap, or centering drifts left. */
  padding: 0.3rem calc(var(--s3) - 0.06em) 0.3rem var(--s3);
  border: 0;
  background: transparent;
  font-family: var(--mono);
  font-size: var(--t-label);
  line-height: 1; /* not the inherited 1.65, or the label sits high in its box */
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-3);
  cursor: pointer;
  transition: color var(--fast) var(--ease), transform var(--fast) var(--ease);
}
.scheme__btn:hover { color: var(--ink); }
.scheme__btn:active { transform: translateY(var(--press)) scale(0.96); }
.scheme__btn[aria-pressed='true'] { color: var(--ink); font-weight: 500; }

/* On mobile and tablet screens, the rail becomes a slim sticky top bar with a hamburger menu.
   The navigation links, search, scheme toggle, and socials collapse cleanly into the drawer. */
@media (max-width: 59.99rem) {
  .rail {
    position: sticky;
    top: 0;
    z-index: 90;
    display: block;
    padding-block: var(--s3);
    margin-inline: calc(-1 * var(--pad-x));
    padding-inline: var(--pad-x);
    background: var(--ground);
    border-bottom: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background var(--fast) var(--ease);
  }

  /* Short border on sides matching inner content padding */
  .rail::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: var(--pad-x);
    right: var(--pad-x);
    height: 1px;
    background: var(--rule);
    transition: background var(--fast) var(--ease), opacity var(--fast) var(--ease);
  }

  .rail__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .identity {
    font-size: var(--t-h3);
    line-height: 1;
  }

  .rail__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: var(--ground);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--fast) var(--ease),
                border-color var(--fast) var(--ease),
                transform var(--fast) var(--ease);
  }

  .rail__toggle:hover {
    background: var(--sunken);
    border-color: var(--ink-3);
  }

  .rail__toggle:active {
    transform: scale(0.95);
  }

  .rail__toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
  }

  .rail__toggle-icon--close {
    display: none;
  }

  .rail.is-open .rail__toggle-icon--menu {
    display: none;
  }

  .rail.is-open .rail__toggle-icon--close {
    display: flex;
  }

  .rail.is-open .rail__toggle {
    background: var(--sunken);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  /* Full-bleed overlay drawer menu */
  .rail__menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--ground);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--rule);
    box-shadow: 0 16px 36px -4px color-mix(in srgb, var(--ink) 16%, transparent),
                0 6px 16px -2px color-mix(in srgb, var(--ink) 8%, transparent);
    display: none;
  }

  .rail.is-open .rail__menu {
    display: block;
    animation: menu-fade var(--fast) var(--ease) both;
  }

  .rail__menu-inner {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    padding-inline: var(--pad-x);
    padding-block: var(--s4);
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
  }

  /* Backdrop: dims page content and absorbs clicks/touches while open */
  .rail__backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: color-mix(in srgb, var(--ground) 35%, rgb(0 0 0 / 0.4));
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    z-index: -1;
    display: none;
    touch-action: none;
  }

  .rail.is-open .rail__backdrop {
    display: block;
    animation: menu-fade var(--fast) var(--ease) both;
  }

  /* Search button inside mobile menu */
  .rail__search {
    width: 100%;
  }

  .rail__menu .search {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--s3) var(--s4);
    background: var(--sunken);
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  /* Nav inside mobile menu */
  .rail__menu .nav {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    margin-inline: 0;
    padding-inline: 0;
  }

  .rail__menu .nav__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s2) var(--s3);
    border-radius: 2px;
    font-size: var(--t-body);
    text-decoration: none;
    color: var(--ink);
  }

  .rail__menu .nav__item:hover {
    background: var(--sunken);
  }

  .rail__menu .nav__item[aria-current='page'] {
    background: var(--sunken);
    color: var(--accent-ink);
    border-left: 2px solid var(--accent);
    font-weight: 500;
  }

  /* Scheme toggle inside mobile menu */
  .rail__menu .rail__scheme {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-block: var(--s1);
  }

  /* Social links inside mobile menu */
  .rail__menu .social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s2);
    width: 100%;
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
  }

  .rail__spacer {
    display: none;
  }
}

@keyframes menu-fade {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ------------------------------------------------------------- masthead */

/* Name and role lead, with the avatar set beside them rather than above. */
.masthead__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s6);
}
.masthead__id { min-width: 0; }
@media (max-width: 32rem) {
  .masthead__head { gap: var(--s4); }
  .masthead__name { font-size: clamp(1.85rem, 8vw, 2.5rem); }
  .masthead__avatar { width: clamp(3.75rem, 18vw, 5rem); }
}
.masthead__avatar {
  flex: none;
  display: block;
  width: clamp(4.5rem, 9vw, 7rem);
  aspect-ratio: 1;
  border: 1px solid var(--rule);
  background: var(--sunken);
  color: var(--ink-2);
}
.masthead__avatar img,
.masthead__avatar svg { width: 100%; height: 100%; }
.masthead__avatar > .light-only,
.masthead__avatar > .dark-only { width: 100%; height: 100%; }

.masthead__name {
  font-size: var(--t-display);
  font-weight: 600;
  line-height: 1.05;
  letter-spacing: -0.025em;
  text-wrap: balance;
}
.masthead__role {
  margin-top: var(--s3);
  font-family: var(--mono);
  font-size: var(--t-mono);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-3);
}
/* The accent appears once here, as the first segment of the rule. */
.masthead__rule {
  margin-block: var(--s5);
  border: 0;
  height: 1px;
  background: linear-gradient(to right, var(--accent) 0 3rem, var(--rule) 3rem);
}
/* -------------------------------------------------------------- controls */
/* One surface for everything clickable that is not running text: adjacent
   entries, an entry's external destinations, the CV actions, scroll to top.
   Square, like the rest of the page, and it presses in rather than lighting up,
   so the feedback is physical instead of decorative. */

.btn {
  --btn-ink: var(--ink-2);
  --btn-edge: var(--rule-strong);
  display: inline-flex;
  align-items: center;
  gap: var(--s2);
  padding: 0.4rem var(--s3);
  border: 1px solid var(--btn-edge);
  border-radius: 2px;
  background: transparent;
  color: var(--btn-ink);
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  line-height: 1.35;
  text-align: left;
  text-decoration: none;
  cursor: pointer;
  transition: color var(--fast) var(--ease),
              border-color var(--fast) var(--ease),
              background var(--fast) var(--ease),
              transform var(--fast) var(--ease),
              box-shadow var(--fast) var(--ease);
}
.btn:hover {
  --btn-ink: var(--ink);
  --btn-edge: var(--ink-3);
  background: var(--sunken);
  transform: translateY(-1px);
  box-shadow: 0 2px 6px -1px color-mix(in srgb, var(--ink) 6%, transparent);
}
.btn:active {
  transform: translateY(var(--press)) scale(0.99);
  box-shadow: none;
}
.btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* Same control, held small enough to sit level with a heading in a section's
   aux slot rather than take a row of its own. */
.btn--small { padding: 0.12rem 0.5rem; gap: 0.35em; font-size: var(--t-label); }

/* The arrow is the direction, so it moves the way the link goes. */
.ui-arrow { flex: none; width: 1em; height: 1em; transition: transform var(--slow) var(--ease-out); }
.btn:hover .ui-arrow { transform: translateX(0.2em); }
.btn--back:hover .ui-arrow { transform: translateX(-0.2em); }
.btn--out:hover .ui-arrow { transform: translate(0.18em, -0.18em); }

/* Expand/collapse button indicator */
.btn--expand .ui-arrow {
  transition: transform var(--slow) var(--ease-spring);
}
.btn--expand[aria-expanded='true'] .ui-arrow {
  transform: rotate(180deg);
}

/* Accented control, for the one action a page actually wants taken. */
.btn--key {
  --btn-ink: var(--accent-ink);
  --btn-edge: var(--accent);
}
.btn--key:hover {
  --btn-ink: var(--on-accent);
  --btn-edge: var(--accent);
  background: var(--accent);
  box-shadow: 0 2px 8px -1px color-mix(in srgb, var(--accent) 30%, transparent);
}

/* ------------------------------------------------------------------ dither */
/* An ordered 4x4 Bayer threshold, drawn as four offset dot grids at decreasing
   opacity. Pixels rather than a smooth ramp, which is the same instrument
   drawing as the rest of the site and survives being scaled. */
.dither {
  position: relative;
  isolation: isolate;
}
.dither::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  --d: 4px;
  background-image:
    radial-gradient(var(--accent) 0.5px, transparent 0.5px),
    radial-gradient(var(--accent) 0.5px, transparent 0.5px),
    radial-gradient(var(--accent) 0.5px, transparent 0.5px);
  background-size: var(--d) var(--d), var(--d) var(--d), var(--d) var(--d);
  background-position: 0 0, 2px 2px, 1px 3px;
  opacity: 0.65;
  /* Fades out along the run, so the texture reads as a gradient of density. */
  -webkit-mask-image: linear-gradient(to right, #000, transparent 78%);
  mask-image: linear-gradient(to right, #000, transparent 78%);
}

/* ------------------------------------------------------------ scroll top */
/* Appears once the page has actually been scrolled, which the script decides.
   Without JS it is never shown, and the page loses nothing. */
.totop {
  position: fixed;
  right: max(var(--pad-x), env(safe-area-inset-right, 0px));
  bottom: max(var(--pad-x), env(safe-area-inset-bottom, 0px));
  z-index: 5;
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  padding: 0;
  border-radius: 2px;
  border: 1px solid var(--rule-strong);
  background: var(--ground);
  opacity: 0;
  transform: translateY(0.5rem) scale(0.92);
  visibility: hidden;
  box-shadow: 0 2px 8px color-mix(in srgb, var(--ink) 8%, transparent);
  transition: opacity var(--slow) var(--ease),
              transform var(--slow) var(--ease-out),
              visibility var(--slow),
              color var(--fast) var(--ease),
              border-color var(--fast) var(--ease),
              background var(--fast) var(--ease),
              box-shadow var(--fast) var(--ease);
}
.totop.is-shown { opacity: 1; transform: none; visibility: visible; }
.totop:hover {
  background: var(--sunken);
  border-color: var(--ink-3);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px color-mix(in srgb, var(--ink) 12%, transparent);
}
.totop:hover .ui-arrow { transform: translateY(-0.18em); }
.totop.is-shown:active { transform: translateY(var(--press)) scale(0.95); box-shadow: none; }
.totop .ui-arrow { width: 1.15rem; height: 1.15rem; transition: transform var(--slow) var(--ease-out); }

/* --------------------------------------------------------------- blocks */

.block { margin-top: var(--s8); }
.block__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--s4);
  padding-bottom: var(--s3);
  border-bottom: 1px solid var(--rule-strong);
}
.block__title {
  font-family: var(--mono);
  font-size: var(--t-mono);
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink);
}
.block__aux {
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}
/* An aux slot showing everything a section has stays plain text; one
   showing fewer becomes a .btn (see btn--small below), never a rule of its
   own, so a control looks like a control everywhere it appears. */

/* ---------------------------------------------------------------- cards */
/* One listing grid for every collection: a metadata stack, the content
   stack, and an optional mark. The date is printed at the precision it was
   authored, so 2023-01 stays 2023-01.

   Bare .card is the compact form, used everywhere by default. card--relaxed
   below holds the same grid taller for an index; card--record, further
   down, is its own shape entirely, sharing this vocabulary of elements
   rather than this layout. Any collection reaches either through the same
   cards.njk macros. */

.cards { display: grid; }
/* Shared with the tags row outside card__link's own grid, so its indent
   cannot drift out of sync with the column it lines up under. */
.card {
  --meta-w: 8rem;
  /* min-width:0, or tags--clamp's unshrinkable row widens the grid track
     instead of being clipped inside it. */
  min-width: 0;
}
/* Lighter than --rule's usual weight: a hint between rows, not a rule. */
.card + .card { border-top: 1px solid color-mix(in srgb, var(--rule) 55%, transparent); }

.card__link {
  display: grid;
  grid-template-columns: var(--meta-w) minmax(0, 1fr);
  gap: var(--s4);
  align-items: baseline;
  padding-block: var(--s3);
  text-decoration: none;
  color: inherit;
}
/* The mark column is reserved only for lists that actually contain one, so a
   list of blog posts does not carry an empty column. */
.cards:has(.mark) .card__link {
  grid-template-columns: var(--meta-w) minmax(0, 1fr) var(--mark-w-list);
}
.card__link > .mark { width: var(--mark-w-list); align-self: start; }

.card__meta { display: grid; gap: 0.1rem; }
.card__date {
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
  transition: color var(--fast) var(--ease);
}
.card__tag {
  display: flex;
  align-items: center;
  gap: var(--s2);
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-3);
}

.card__main { display: grid; gap: 0.1rem; min-width: 0; }
.card__title {
  font-size: var(--t-small);
  font-weight: 500;
  line-height: 1.35;
  text-wrap: pretty;
  text-decoration: underline;
  text-decoration-color: transparent;
  text-underline-offset: 0.2em;
  text-decoration-thickness: 1px;
  transition: text-decoration-color var(--fast) var(--ease),
              color var(--fast) var(--ease),
              transform var(--fast) var(--ease);
}
/* One line in the compact form so every row is the same height. */
.card__sub {
  font-size: 0.9375rem;
  line-height: 1.35;
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: color var(--fast) var(--ease);
}
.card__link:hover .card__title {
  text-decoration-color: var(--accent);
  transform: translateX(2.5px);
}
.card__link:active .card__title {
  transform: translateX(1.5px) translateY(var(--press));
}
.card__link:hover .card__date { color: var(--ink-2); }
.card__link:hover .card__sub { color: var(--ink-2); }

/* Ongoing is the one piece of content state the accent marks. */
.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  flex: none;
  display: inline-block;
  vertical-align: 0.12em;
}

/* --------------------------------------------------- collapsible drawers */

.cards-expandable {
  display: flex;
  flex-direction: column;
}
.cards-expandable__action {
  display: flex;
  justify-content: center;
  margin-top: var(--s4);
}
.collapsible-drawer {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows var(--duration-expand) var(--ease),
              opacity var(--duration-expand) var(--ease);
  opacity: 0;
}
.collapsible-drawer[data-expanded='true'] {
  grid-template-rows: 1fr;
  opacity: 1;
}
.collapsible-drawer__inner {
  overflow: hidden;
  min-height: 0;
}
.collapsible-drawer[data-expanded='true'] .cards--extra > .card {
  animation: card-reveal 320ms var(--ease-out) both;
}
.collapsible-drawer[data-expanded='true'] .cards--extra > .card:nth-child(1) { animation-delay: 30ms; }
.collapsible-drawer[data-expanded='true'] .cards--extra > .card:nth-child(2) { animation-delay: 60ms; }
.collapsible-drawer[data-expanded='true'] .cards--extra > .card:nth-child(3) { animation-delay: 90ms; }
.collapsible-drawer[data-expanded='true'] .cards--extra > .card:nth-child(4) { animation-delay: 120ms; }
.collapsible-drawer[data-expanded='true'] .cards--extra > .card:nth-child(n+5) { animation-delay: 150ms; }

@keyframes card-reveal {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 40rem) {
  /* The meta column moves below the title at this width (order, just below),
     so nothing is left for the tags row to line up against either. */
  .card { --meta-w: 0rem; }
  .card__link { grid-template-columns: minmax(0, 1fr) var(--mark-w-list); gap: var(--s1) var(--s3); }
  .cards:has(.mark) .card__link { grid-template-columns: minmax(0, 1fr) var(--mark-w-list); }
  .card__main { grid-column: 1; order: 1; }
  .card__meta { grid-column: 1; order: 2; }
  .card__link > .mark { grid-column: 2; grid-row: 1; order: 0; }
  /* One line cuts too much at this width, so the compact form gets two. */
  .card__sub {
    white-space: normal;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .card--relaxed .card__sub { display: block; }
}

/* card--relaxed: the index variant. Taller, adds the description under the
   attribution. Takes its items in whatever order the page passes; it does
   not sort or group them itself.

   padding-block belongs to the card, not card__link: the same either way a
   card ends, in the link (no skills) or in tags (skills follow it). */
.card--relaxed { padding-block: var(--s4); }
.card--relaxed .card__link { align-items: start; padding-block: 0; }
.card--relaxed .card__sub { white-space: normal; overflow: visible; }
/* Skill tags sit outside card__link (an <a> cannot nest another one), so
   they line up under the title by margin, not a shared grid column. */
.card--relaxed > .tags { margin-left: calc(var(--meta-w) + var(--s4)); }
@media (max-width: 40rem) {
  .card--relaxed > .tags { margin-left: 0; }
}
/* Clamped and plain by default; card__desc--full is the CV's Publications
   and Projects opting out, where a record has room for the whole thing. */
.card__desc {
  margin-top: 0.15rem;
  font-size: 0.9375rem;
  line-height: 1.5;
  color: var(--ink-3);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card__desc--full {
  display: block;
  -webkit-line-clamp: unset;
  line-clamp: unset;
  overflow: visible;
}
/* Markdown's own elements, not .prose's: only card__desc--full ever renders
   any, since the clamped default is plain text already. */
.card__desc--full > * + * { margin-top: 0.3em; }
.card__desc--full ul, .card__desc--full ol { padding-left: 1.1em; }
.card__desc--full ul { list-style: disc; }
.card__desc--full ol { list-style: decimal; }
.card__desc--full li + li { margin-top: 0.15em; }
.card__desc--full a { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.15em; }
.card__desc--full a:hover { color: var(--ink); }
.card__desc--full code { font-family: var(--mono); font-size: 0.85em; }

/* ----------------------------------------------------------- skills map */
/* Weight is the subject of this page, so the bar is the one place the accent
   is used as data rather than as state. One bar per tier keeps it to a few. */

.tier {
  display: grid;
  gap: var(--s4);
  padding-block: var(--s4);
  align-items: start;
  transition: opacity var(--fast) var(--ease);
}
.tier.is-filtered-out { display: none; }
.tiers { display: grid; }
.tier + .tier { border-top: 1px solid var(--rule); }
@media (min-width: 34rem) {
  .tier { grid-template-columns: 7rem minmax(0, 1fr); }
}
.tier__weight { display: grid; gap: var(--s2); }
.tier__bar {
  display: block;
  height: 3px;
  width: var(--w, 2px);
  min-width: 3px;
  background: var(--accent);
  border-radius: 1px;
  transform-origin: left center;
  animation: bar-grow 500ms var(--ease-out) both;
}
@keyframes bar-grow {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}
.tier:nth-child(1) .tier__bar { animation-delay: 40ms; }
.tier:nth-child(2) .tier__bar { animation-delay: 80ms; }
.tier:nth-child(3) .tier__bar { animation-delay: 120ms; }
.tier:nth-child(4) .tier__bar { animation-delay: 160ms; }
.tier:nth-child(n+5) .tier__bar { animation-delay: 200ms; }

.tier__count {
  font-family: var(--mono);
  font-size: var(--t-mono);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
  transition: color var(--fast) var(--ease);
}
.tier:hover .tier__count { color: var(--ink-2); }
.tier__items { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s4); }
.tier__item {
  /* Inline boxes cannot be transformed, and this one is pressed. */
  display: inline-block;
  font-size: var(--t-small);
  color: var(--ink);
  text-decoration: underline;
  text-decoration-color: transparent;
  text-underline-offset: 0.2em;
  transition: text-decoration-color var(--fast) var(--ease),
              color var(--fast) var(--ease),
              transform var(--fast) var(--ease),
              opacity var(--fast) var(--ease);
}
.tier__item.is-filtered-out { display: none; }
.tier__item.is-filtered-in { animation: search-item-in 140ms var(--ease) both; }
.tier__item:hover {
  color: var(--accent-ink);
  text-decoration-color: var(--accent);
  transform: translateY(-1.5px);
}
.tier__item:active { transform: translateY(var(--press)); }

/* ---------------------------------------------------------------- prose */

/* Prose keeps a comfortable reading measure, but tables, code and figures are
   allowed the full width of the column, because they are scanned, not read. */
.prose {
  max-width: none;
  overflow-wrap: break-word;
}
.prose > * + * { margin-top: var(--s4); }
.prose > p,
.prose > ul,
.prose > ol,
.prose > dl,
.prose > blockquote,
.prose > h2,
.prose > h3,
.prose > h4,
.prose > h5,
.prose > h6 { max-width: var(--measure-text); }
@media (max-width: 59.99rem) {
  .prose > p,
  .prose > ul,
  .prose > ol,
  .prose > dl,
  .prose > blockquote,
  .prose > h2,
  .prose > h3,
  .prose > h4,
  .prose > h5,
  .prose > h6 { max-width: 100%; }
}
.prose h1, .prose h2, .prose h3 { line-height: var(--lh-tight); letter-spacing: -0.012em; text-wrap: balance; }
/* The page already supplies the title, so an h1 inside a body is a duplicate.
   Styled to the same size as h2 so it never outshouts the real heading. */
.prose h1 { margin-top: var(--s7); font-size: var(--t-h2); font-weight: 600; }
.prose h2 { margin-top: var(--s7); font-size: var(--t-h2); font-weight: 600; }
.prose h3 { margin-top: var(--s6); font-size: var(--t-h3); font-weight: 600; }
/* Without these the browser defaults take over and h4 comes out larger than the
   h3 above it. The ramp keeps going down instead, and h6 becomes a label. */
.prose h4, .prose h5, .prose h6 { line-height: var(--lh-tight); letter-spacing: -0.006em; }
.prose h4 { margin-top: var(--s6); font-size: 1.0625rem; font-weight: 600; }
.prose h5 { margin-top: var(--s5); font-size: var(--t-small); font-weight: 600; color: var(--ink-2); }
.prose h6 {
  margin-top: var(--s5);
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-3);
}
.prose a {
  color: var(--ink);
  text-decoration: underline;
  text-decoration-color: var(--accent);
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
  transition: text-decoration-thickness var(--fast) var(--ease), color var(--fast) var(--ease);
}
.prose a:visited { color: var(--ink-2); }
.prose a:hover { color: var(--accent-ink); text-decoration-thickness: 2px; }
.prose code {
  font-family: var(--mono);
  font-size: 0.875em;
  padding: 0.1em 0.35em;
  background: var(--sunken);
  border: 1px solid var(--rule);
  /* Without this a chip that wraps loses its padding and border on one fragment,
     which is very visible inside a narrow table cell. */
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
}
.prose pre {
  padding: var(--s4);
  background: var(--sunken);
  border: 1px solid var(--rule);
  overflow-x: auto;
  font-size: var(--t-mono);
  line-height: 1.6;
}
.prose pre code { padding: 0; background: none; border: 0; font-size: inherit; }

/* --------------------------------------------------------------- syntax */
/* GitHub's light and dark defaults, which most readers already recognise from
   the place they read code. Highlighting is done at build time, so a page with
   code ships no highlighter; these classes are all that arrives.

   Comment and title sit one step darker than upstream. The code ground here is
   --sunken rather than white, and at the original values both fell under 4.5. */

:root {
  --syn-comment: #656d76;
  --syn-keyword: #cf222e;
  --syn-string:  #0a3069;
  --syn-number:  #0550ae;
  --syn-title:   #6f42c1;
  --syn-type:    #953800;
  --syn-name:    #116329;
  --syn-add-ink: #116329;
  --syn-add-bg:  rgb(17 99 41 / 0.12);
  --syn-del-ink: #82071e;
  --syn-del-bg:  rgb(130 7 30 / 0.12);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    --syn-comment: #8b949e;
    --syn-keyword: #ff7b72;
    --syn-string:  #a5d6ff;
    --syn-number:  #79c0ff;
    --syn-title:   #d2a8ff;
    --syn-type:    #ffa657;
    --syn-name:    #7ee787;
    --syn-add-ink: #7ee787;
    --syn-add-bg:  rgb(126 231 135 / 0.12);
    --syn-del-ink: #ffa198;
    --syn-del-bg:  rgb(255 161 152 / 0.12);
  }
}
:root[data-theme='dark'] {
  --syn-comment: #8b949e;
  --syn-keyword: #ff7b72;
  --syn-string:  #a5d6ff;
  --syn-number:  #79c0ff;
  --syn-title:   #d2a8ff;
  --syn-type:    #ffa657;
  --syn-name:    #7ee787;
  --syn-add-ink: #7ee787;
  --syn-add-bg:  rgb(126 231 135 / 0.12);
  --syn-del-ink: #ffa198;
  --syn-del-bg:  rgb(255 161 152 / 0.12);
}

.hljs-comment, .hljs-quote { color: var(--syn-comment); font-style: italic; }
.hljs-keyword, .hljs-selector-tag, .hljs-literal, .hljs-doctag { color: var(--syn-keyword); }
.hljs-string, .hljs-regexp, .hljs-symbol, .hljs-bullet { color: var(--syn-string); }
.hljs-number, .hljs-attr, .hljs-attribute, .hljs-variable, .hljs-meta, .hljs-selector-pseudo,
.hljs-template-variable { color: var(--syn-number); }
.hljs-title, .hljs-title.function_, .hljs-section { color: var(--syn-title); }
.hljs-type, .hljs-title.class_, .hljs-built_in, .hljs-params { color: var(--syn-type); }
.hljs-name, .hljs-tag, .hljs-selector-class { color: var(--syn-name); }
.hljs-emphasis { font-style: italic; }
.hljs-strong { font-weight: 600; }
/* A diff needs its own ground, since colour alone is the whole signal. */
.hljs-addition { color: var(--syn-add-ink); background: var(--syn-add-bg); }
.hljs-deletion { color: var(--syn-del-ink); background: var(--syn-del-bg); }
.prose blockquote {
  padding-left: var(--s4);
  border-left: 2px solid var(--rule-strong);
  color: var(--ink-2);
}
.prose ul, .prose ol { padding-left: var(--s5); }
.prose ul { list-style: disc; }
.prose ol { list-style: decimal; }
.prose li + li { margin-top: var(--s2); }
/* `> * + *` only reaches the top level, so a loose list item or a quote with an
   attribution had its paragraphs running together. */
.prose li > * + *,
.prose blockquote > * + * { margin-top: var(--s3); }
.prose li > ul,
.prose li > ol { margin-top: var(--s2); }
.prose li::marker { color: var(--ink-3); }
.prose table { width: 100%; border-collapse: collapse; font-size: var(--t-small); }
.prose th, .prose td { text-align: left; padding: var(--s2) var(--s3); border-bottom: 1px solid var(--rule); }
.prose th { font-family: var(--mono); font-size: var(--t-mono-s); font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); }
/* Centred, because a drawing narrower than the column reads as a mistake when it
   is jammed against the left edge while a wide one fills the measure. */
.prose img,
.prose .inline-svg {
  display: block;
  margin-block: var(--s5);
  margin-inline: auto;
  max-width: 100%;
  height: auto;
  padding: 8px;
  background: var(--sunken);
  border: 1px solid var(--rule);
}
.prose .figure img,
.prose .figure .inline-svg { margin-block: 0; padding: 0; background: none; border: 0; }
.figure .inline-svg { width: 100%; }

.prose figure { margin-block: var(--s5); }
.prose figure > img,
.prose figure > .inline-svg { margin-block: 0; }
.prose figcaption {
  margin-top: var(--s3);
  font-size: var(--t-small);
  line-height: var(--lh-ui);
  text-align: center;
  text-wrap: balance;
  color: var(--ink-3);
}

/* Responsive media and embedded documents */
.prose iframe,
.prose video {
  display: block;
  width: 100%;
  max-width: 100%;
  margin-block: var(--s5);
  border: 1px solid var(--rule);
  background: var(--sunken);
}
.prose iframe { min-height: 24rem; }
@media (max-width: 40rem) {
  .prose iframe { min-height: 18rem; }
}

/* A table is sized by its columns, so a wide one would push the page sideways. */
.table-scroll { overflow-x: auto; max-width: 100%; }
.prose .table-scroll { margin-block: var(--s5); }
.prose .table-scroll table { margin: 0; }

/* Long formulas scroll rather than widening the page. */
.katex-display { overflow-x: auto; overflow-y: hidden; padding-block: var(--s1); }

/* Elements markdown only reaches through raw HTML. Left to the browser they
   arrive with default styling that ignores the palette, so mark came out in
   bright yellow and a definition list read as undifferentiated paragraphs. */
.prose dl { display: grid; grid-template-columns: auto 1fr; gap: var(--s2) var(--s4); }
.prose dt {
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--ink-3);
  padding-top: 0.28em;
}
.prose dd { margin: 0; }

.prose details {
  padding: var(--s3) var(--s4);
  background: var(--sunken);
  border: 1px solid var(--rule);
}
.prose summary {
  cursor: pointer;
  font-weight: 600;
  /* The default triangle sits outside the padding and cannot be coloured. */
  list-style: none;
  display: flex;
  align-items: baseline;
  gap: var(--s2);
}
.prose summary::-webkit-details-marker { display: none; }
.prose summary::before {
  content: '';
  width: 0;
  height: 0;
  border-left: 5px solid var(--accent);
  border-block: 4px solid transparent;
  transition: transform var(--fast) var(--ease);
}
.prose details[open] > summary::before { transform: rotate(90deg); }
.prose details[open] > summary { margin-bottom: var(--s3); }

.prose kbd {
  font-family: var(--mono);
  font-size: 0.8125em;
  padding: 0.15em 0.4em;
  background: var(--ground);
  border: 1px solid var(--rule-strong);
  border-bottom-width: 2px;
  white-space: nowrap;
}
.prose mark {
  background: color-mix(in srgb, var(--accent) 26%, transparent);
  color: inherit;
  padding: 0.05em 0.15em;
  /* Same reason as code: a highlight that wraps must keep its padding on both halves. */
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
}
.prose abbr[title] {
  text-decoration: underline dotted var(--rule-strong);
  text-underline-offset: 0.2em;
  cursor: help;
}
.prose sub, .prose sup { line-height: 0; font-size: 0.75em; }
.prose del { color: var(--ink-3); }
.prose ins { text-decoration: underline; text-decoration-color: var(--accent); }
.prose hr { margin-block: var(--s6); border: 0; border-top: 1px solid var(--rule); }

/* ------------------------------------------------------------- languages */
/* Name and level per row, on the same grid the aside rows use, so a short list
   reads as a table without being one. */
.languages { display: grid; gap: var(--s2); margin-top: var(--s4); }
.language {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--s4);
  align-items: baseline;
}
.language__name { font-size: var(--t-small); }
.language__level {
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  color: var(--ink-3);
}

/* --------------------------------------------------------------- footer */

.foot {
  margin-top: var(--s8);
  padding-block: var(--s4) var(--s6);
  /* Same column as the body above it. Left to fill .main it ran past every rule
     on the page, and on a page with a margin column it reached under the aside. */
  max-width: 100%;
  border-top: 1px solid var(--rule);
  display: flex;
  flex-wrap: wrap;
  gap: var(--s2) var(--s5);
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}
@media (min-width: 60rem) {
  .foot { max-width: var(--measure); }
}


/* ------------------------------------------------------------ pageheads */

/* The gap below the kicker rather than above the title, so a title sharing a
   row with a mark starts at the row top and the two line up. */
.pagehead__kicker {
  margin-bottom: var(--s2);
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.pagehead__kicker a { color: inherit; text-decoration: none; }
.pagehead__kicker a:hover { color: var(--accent-ink); }
.pagehead__title {
  font-size: var(--t-h1);
  font-weight: 600;
  line-height: var(--lh-tight);
  letter-spacing: -0.02em;
  text-wrap: balance;
  overflow-wrap: break-word;
}
/* Only pageheads that carry a mark use this wrapper; the rest stay plain. */
.pagehead__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s4);
}
.pagehead__id { min-width: 0; }
.pagehead__sub { margin-top: var(--s2); font-size: var(--t-small); color: var(--ink-2); }
.pagehead__byline { margin-top: var(--s1); font-size: var(--t-small); color: var(--ink-3); }

/* The entry's external destinations, set with the title rather than after the
   body. They are controls: leaving the site is a decision, so it gets a target
   to press rather than a phrase to notice. The arrow is a real glyph in the
   button, so it inherits colour and moves on hover with everything else. */
.pagehead__links {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s2);
  margin-top: var(--s4);
}
.pagehead__links .btn { max-width: 100%; }
.pagehead__links .btn > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* The kicker carries the ongoing marker, matching how rows show it. */
.pagehead__kicker .dot { display: inline-block; margin: 0 0.5em 0 0.7em; vertical-align: 0.1em; }
/* Plain, unlike the masthead rule. The accent segment is a signature, not a divider. */
.pagehead__rule { margin-block: var(--s5); border: 0; height: 1px; background: var(--rule); }

.block--flush { margin-top: var(--s6); }
.empty { font-family: var(--mono); font-size: var(--t-mono); color: var(--ink-3); }
.key {
  padding: 0.05em 0.35em;
  border: 1px solid var(--rule-strong);
  font-family: var(--mono);
  font-size: 0.85em;
  color: var(--ink-2);
}

/* -------------------------------------------------------- card--record */
/* CV entries. Same date-left instinct as a list card, with room for a note.

   Three columns: dates, text, mark. Only the heading yields to the mark; the
   detail below spans past it, so a note keeps the full column width. The
   mark column is a fixed width rather than auto, so a record without a logo
   still lines up with one that has it.

   card__title and card__sub are the same elements a list card uses; only
   their size and link treatment change here, since a record's title carries
   its own link and its sub-line is prose rather than a clipped one-liner. */
.card--record {
  display: grid;
  grid-template-columns: minmax(0, 1fr) var(--mark-w);
  gap: var(--s3) var(--s4);
  align-items: start;
  padding-block: var(--s5);
}
.card--record + .card--record { border-top: 1px solid var(--rule); }
.card__when { grid-column: 1; grid-row: 1; }
.card--record > .mark { grid-column: 2; grid-row: 1; }
.card__heading { grid-column: 1 / -1; grid-row: 2; }
.card--record .card__detail { grid-column: 1 / -1; grid-row: 3; }

@media (min-width: 46rem) {
  .card--record { grid-template-columns: 11rem minmax(0, 1fr) var(--mark-w); column-gap: var(--s5); }
  .card__heading { grid-column: 2; grid-row: 1; }
  .card--record > .mark { grid-column: 3; grid-row: 1; }
  .card--record .card__detail { grid-column: 2 / span 2; grid-row: 2; }
}
/* The grid row gap already separates it from the heading. */
.card--record .card__detail > :first-child { margin-top: 0; }
.card__when {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.3rem;
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  line-height: var(--lh-ui);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}
.card__span { flex-basis: 100%; color: var(--ink-3); }
.card--record .card__title { font-size: var(--t-h3); font-weight: 600; line-height: var(--lh-tight); }
.card--record .card__sub {
  margin-top: var(--s1);
  font-size: var(--t-small);
  color: var(--ink-2);
  /* card__sub's base rule clips to one line for the compact form; a record's
     sub-line runs longer (organisation, type, modality, location, grade) and
     has the room to wrap instead. */
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}

/* An organisation mark, mounted the same way the avatar and the cover figures
   are, so every image on the site reads alike. Shared by CV records and by the
   credential entries that carry an issuer logo. */
.mark {
  display: grid;
  place-items: center;
  width: var(--mark-w);
  aspect-ratio: 1;
  padding: 0.45rem;
  border: 1px solid var(--rule);
  background: var(--sunken);
  /* Inlined marks drawn with currentColor resolve against this. */
  color: var(--ink-3);
}
.mark img,
.mark svg { width: 100%; height: 100%; object-fit: contain; }
/* The themed pair wrappers keep their own display, so they are sized, not collapsed. */
.mark > .light-only,
.mark > .dark-only { width: 100%; height: 100%; }
/* A publication or project titles its own entry, so the title carries the link
   rather than the sub-line. Underlined on hover only, like a list card. */
.card--record .card__title a {
  color: inherit;
  text-decoration: underline;
  text-decoration-color: transparent;
  text-underline-offset: 0.2em;
  transition: text-decoration-color var(--fast) var(--ease);
}
.card--record .card__title a:hover { text-decoration-color: var(--accent); }
.card--record .card__sub a { color: inherit; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.18em; }
.card--record .card__sub a:hover { color: var(--accent-ink); }
.card__note { margin-top: var(--s3); font-size: var(--t-small); color: var(--ink-2); }
.card__note > * + * { margin-top: var(--s3); }
.card__note ul, .card__note ol { padding-left: 1.1em; }
.card__note ul { list-style: disc; }
.card__note ol { list-style: decimal; }
.card__note li + li { margin-top: 0.15em; }
.card__note a { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.15em; }
.card__note a:hover { color: var(--ink); }
.card__note code { font-family: var(--mono); font-size: 0.85em; }

.tags { display: flex; flex-wrap: wrap; gap: var(--s2); margin-top: var(--s3); }
/* One row: whatever does not fit fades out rather than wrapping or cutting a pill in half. */
.tags--clamp {
  flex-wrap: nowrap;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent);
  mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent);
}
.tags--clamp > li { flex: none; }
.tags a {
  display: inline-block;
  padding: 0.12rem var(--s2);
  border: 1px solid var(--rule);
  border-radius: 2px;
  background: transparent;
  font-family: var(--mono);
  font-size: var(--t-label);
  color: var(--ink-3);
  text-decoration: none;
  transition: color var(--fast) var(--ease),
              border-color var(--fast) var(--ease),
              background var(--fast) var(--ease),
              transform var(--fast) var(--ease),
              box-shadow var(--fast) var(--ease);
}
.tags a:hover {
  color: var(--ink);
  border-color: var(--accent);
  background: var(--sunken);
  transform: translateY(-1.5px);
  box-shadow: 0 2px 4px -1px color-mix(in srgb, var(--ink) 6%, transparent);
}
.tags a:active {
  transform: translateY(var(--press));
  box-shadow: none;
}

/* --------------------------------------------------------------- entries */

.lede {
  margin-block: var(--s5);
  max-width: var(--measure-text);
  font-size: 1.3125rem;
  line-height: 1.5;
  color: var(--ink-2);
  text-wrap: pretty;
  overflow-wrap: break-word;
}
@media (max-width: 59.99rem) {
  .lede { max-width: 100%; }
}
.cv-summary {
  font-size: var(--t-body);
  line-height: var(--lh-prose);
}
/* Markdown's own elements, not .prose's: a summary is a paragraph or two and
   maybe a list, not a full article body. */
.lede > * + * { margin-top: 0.6em; }
.lede ul, .lede ol { padding-left: 1.15em; }
.lede ul { list-style: disc; }
.lede ol { list-style: decimal; }
.lede li + li { margin-top: 0.3em; }
.lede a { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.15em; }
.lede a:hover { color: var(--accent-ink); }
.lede code { font-family: var(--mono); font-size: 0.8em; }

/* A mount rather than a bare image. Cover art is usually bright, so on the dark
   theme an unmounted image reads as a hole punched in the page. The matte gives
   it an edge to sit against in both themes. */
/* Figures are numbered by a CSS counter, so the cover and any figure in the
   body share one sequence and nothing has to be numbered by hand. */
.entry { counter-reset: figure; }
.figure {
  margin-block: var(--s6);
  padding: 8px;
  background: var(--sunken);
  border: 1px solid var(--rule);
  counter-increment: figure;
}
.figure img { width: 100%; }
.figure figcaption {
  display: flex;
  align-items: baseline;
  gap: var(--s3);
  padding: var(--s2) 4px 2px;
}
.figure figcaption::before {
  content: 'Fig. ' counter(figure, decimal-leading-zero);
  flex: none;
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--accent-ink);
}
.figure__text {
  font-size: 0.875rem;
  line-height: var(--lh-ui);
  color: var(--ink-3);
  text-wrap: pretty;
}

/* Themed asset pairs follow the toggle, not only the system preference. */
.dark-only { display: none; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) .light-only { display: none; }
  :root:not([data-theme='light']) .dark-only { display: block; }
}
:root[data-theme='dark'] .light-only { display: none; }
:root[data-theme='dark'] .dark-only { display: block; }
:root[data-theme='light'] .light-only { display: block; }
:root[data-theme='light'] .dark-only { display: none; }


/* Two real controls rather than two underlined phrases. Direction is carried by
   the arrow and by which edge the button sits against, so the pair reads as
   previous and next before either label is. */
.adjacent {
  margin-top: var(--s8);
  padding-top: var(--s5);
  border-top: 1px solid var(--rule-strong);
  display: grid;
  gap: var(--s3);
}
@media (min-width: 40rem) { .adjacent { grid-template-columns: 1fr 1fr; gap: var(--s4); } }
.adjacent__link {
  align-items: center;
  gap: var(--s3);
  padding: var(--s3) var(--s4);
  min-width: 0;
}
/* Sits in the second cell even when it is the only one, so next is always right. */
.adjacent__link--next { grid-column: -2; }
/* Fills the space between the arrow and the far edge, so text-align has the whole
   button to work against. Sized to its content it would hug the wrong edge
   whenever the title was short, which is most of them. */
.adjacent__text { flex: 1 1 auto; display: grid; gap: 0.1rem; min-width: 0; }
.adjacent__link--next .adjacent__text { text-align: right; }
.adjacent__dir {
  font-size: var(--t-label);
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--ink-3);
  transition: color var(--fast) var(--ease);
}
.adjacent__link:hover .adjacent__dir { color: var(--accent-ink); }
.adjacent__title {
  font-family: var(--sans);
  font-size: var(--t-small);
  font-weight: 500;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.adjacent__link .ui-arrow { width: 1.15rem; height: 1.15rem; }

/* ----------------------------------------------------------------- aside */
/* The margin column. Everything the engine precomputes lives here rather
   than crowding the space under a title. */

.aside__block + .aside__block { margin-top: var(--s5); }
.aside__label {
  padding-bottom: var(--s2);
  border-bottom: 1px solid var(--rule);
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.aside__list { margin-top: var(--s3); display: grid; gap: var(--s3); }
.aside__row { display: grid; gap: 0.1rem; }
.aside__row dt {
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.aside__row dd { font-size: var(--t-mono); line-height: var(--lh-ui); color: var(--ink-2); }
.aside__row dd a { color: inherit; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.18em; }
.aside__row dd a:hover { color: var(--accent-ink); }
.is-mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.flag {
  padding: 0 0.3rem;
  background: var(--accent);
  color: var(--on-accent);
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* The reading rail. The rule doubles as a progress indicator: the accent fills
   it as the article is read, while the labels carry position. Two signals, one
   element, and both degrade to a plain table of contents without JS. */
.toc { position: relative; margin-top: var(--s3); padding-left: var(--s4); }
.toc::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.3em;
  bottom: 0.3em;
  width: 1px;
  background: var(--rule-strong);
}
.toc__fill {
  position: absolute;
  left: 0;
  /* Spans exactly the rule, then scales to the share that has been read. */
  top: 0.3em;
  bottom: 0.3em;
  width: 1px;
  background: var(--accent);
  transform: scaleY(var(--read, 0));
  transform-origin: top center;
  transition: transform 100ms linear;
}
.toc__list { display: grid; gap: var(--s2); }
.toc__item a[aria-current] { color: var(--ink); }
.toc__item a {
  display: block;
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  line-height: 1.4;
  color: var(--ink-3);
  text-decoration: none;
  transition: color var(--fast) var(--ease);
}
.toc__item a:hover { color: var(--ink); }
.toc__item--l3 { padding-left: var(--s3); }

/* On desktop (>= 72rem), the sticky .page__aside holds details, TOC, and skills.
   The mobile inline counterparts are hidden. */
@media (min-width: 72rem) {
  .entry__meta,
  .toc-mobile {
    display: none;
  }
}

/* On mobile (< 72rem), .page__aside at the bottom of the page is hidden,
   since .entry__meta and .toc-mobile present everything before the prose. */
@media (max-width: 71.99rem) {
  .page--split .page__aside {
    display: none;
  }
}

/* Inline entry metadata on mobile (< 72rem) */
.entry__meta {
  margin-block: var(--s4) var(--s5);
  padding: var(--s4);
  background: var(--sunken);
  border: 1px solid var(--rule);
}
.entry__meta-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
  gap: var(--s2) var(--s4);
}
.entry__meta-item dt {
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-3);
}
.entry__meta-item dd {
  margin: 0;
  margin-top: 0.15rem;
  font-size: var(--t-small);
  color: var(--ink);
}
.entry__meta-skills {
  margin-top: var(--s3);
  padding-top: var(--s3);
  border-top: 1px solid var(--rule);
}
.entry__meta-skills .tags {
  margin-top: 0;
}

/* Mobile Table of Contents */
.toc-mobile {
  margin-block: var(--s4) var(--s6);
  padding: var(--s3) var(--s4);
  background: var(--sunken);
  border: 1px solid var(--rule);
  transition: border-color var(--fast) var(--ease),
              background var(--fast) var(--ease);
}
.toc-mobile:hover {
  border-color: var(--rule-strong);
}
.toc-mobile__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  user-select: none;
  list-style: none;
  padding-block: var(--s1);
}
.toc-mobile__summary::-webkit-details-marker {
  display: none;
}
.toc-mobile__summary .aside__label {
  padding-bottom: 0;
  border-bottom: 0;
}
.toc-mobile__icon {
  display: inline-block;
  width: 0.45rem;
  height: 0.45rem;
  border-right: 1.5px solid var(--ink-3);
  border-bottom: 1.5px solid var(--ink-3);
  transform: rotate(45deg);
  transition: transform var(--slow) var(--ease-out),
              border-color var(--fast) var(--ease);
}
.toc-mobile:hover .toc-mobile__icon {
  border-color: var(--ink);
}
.toc-mobile[open] .toc-mobile__icon {
  transform: rotate(-135deg);
}
.toc-mobile .toc-mobile__drawer {
  display: grid;
  grid-template-rows: 1fr;
  transition: grid-template-rows var(--duration-expand) var(--ease),
              opacity var(--duration-expand) var(--ease);
  opacity: 1;
}
.toc-mobile:not([open]) .toc-mobile__drawer,
.toc-mobile.is-closing .toc-mobile__drawer {
  grid-template-rows: 0fr;
  opacity: 0;
}
.toc-mobile__inner {
  overflow: hidden;
  min-height: 0;
}
.toc-mobile .toc__list {
  margin-top: var(--s3);
  padding-top: var(--s3);
  border-top: 1px solid var(--rule);
}

/* --------------------------------------------------------- cards--timeline */
/* The CV's one built element rather than styled element. A continuous spine
   with a node per record, filled when the role is still running. The rule
   draws once on load, which is the whole of the motion here. */

.cards--timeline { position: relative; }
.cards--timeline .card--record { position: relative; padding-left: 2rem; }
/* The nodes separate the records, so the shared rule would be noise. */
.cards--timeline .card--record + .card--record { border-top: 0; }

/* Each record carries the segment down to the next node, so the spine spans
   node to node and a lone record shows a node with nothing trailing off it. */
.cards--timeline .card--record::after {
  content: '';
  position: absolute;
  left: 6px;
  top: 2.6rem;
  bottom: -1.4rem;
  width: 1px;
  background: var(--rule-strong);
  transform-origin: top center;
  animation: tl-draw 420ms var(--ease) both;
}
.cards--timeline .card--record:last-child::after { content: none; }
.cards--timeline .card--record::before {
  content: '';
  position: absolute;
  left: 0;
  top: 1.6rem;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  border: 1px solid var(--rule-strong);
  background: var(--ground);
  animation: tl-node 300ms var(--ease) both;
}
/* Ongoing is the same accent used for the ongoing dot everywhere else. */
.cards--timeline .card--record.is-current::before { border-color: var(--accent); background: var(--accent); }

.cards--timeline .card--record:nth-child(1)::before, .cards--timeline .card--record:nth-child(1)::after { animation-delay: 120ms; }
.cards--timeline .card--record:nth-child(2)::before, .cards--timeline .card--record:nth-child(2)::after { animation-delay: 260ms; }
.cards--timeline .card--record:nth-child(3)::before, .cards--timeline .card--record:nth-child(3)::after { animation-delay: 380ms; }
.cards--timeline .card--record:nth-child(4)::before, .cards--timeline .card--record:nth-child(4)::after { animation-delay: 480ms; }
.cards--timeline .card--record:nth-child(5)::before, .cards--timeline .card--record:nth-child(5)::after { animation-delay: 560ms; }
.cards--timeline .card--record:nth-child(n + 6)::before, .cards--timeline .card--record:nth-child(n + 6)::after { animation-delay: 620ms; }

@keyframes tl-draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }
@keyframes tl-node { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: scale(1); } }

/* On screen the rail carries contact details, so this only exists on paper. */
.printonly { display: none; }

.contacts {
  margin-top: var(--s2);
  font-family: var(--mono);
  font-size: var(--t-mono-s);
  color: var(--ink-2);
}

/* Both actions are controls now, so the row is just their spacing. */
.cv-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--s3);
  margin-top: var(--s4);
}

/* ---------------------------------------------------------- page search */
/* Inline search box on collection index pages. Shares visual language with
   the palette but renders as a static page element rather than a modal. */

.page-search {
  margin-bottom: var(--s5);
}
.page-search__input {
  width: 100%;
  padding: var(--s3) var(--s4);
  border: 1px solid var(--rule-strong);
  border-radius: 2px;
  background: var(--ground);
  font-family: var(--sans);
  font-size: var(--t-body);
  color: var(--ink);
  transition: border-color var(--fast) var(--ease),
              box-shadow var(--fast) var(--ease);
}
.page-search__input::placeholder { color: var(--ink-3); }
.page-search__input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent);
}
.page-search__results {
  margin-top: var(--s3);
  transition: opacity var(--fast) var(--ease);
}
.page-search__results:empty { display: none; }
.page-search__status {
  padding: var(--s2) 0;
  margin-bottom: var(--s3);
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-3);
  animation: search-item-in 140ms var(--ease) both;
}
.page-search__results .card.is-entering {
  animation: search-item-in 140ms var(--ease) both;
}
.page-search__results .card.is-entering:nth-child(1) { animation-delay: 0ms; }
.page-search__results .card.is-entering:nth-child(2) { animation-delay: 20ms; }
.page-search__results .card.is-entering:nth-child(3) { animation-delay: 40ms; }
.page-search__results .card.is-entering:nth-child(4) { animation-delay: 60ms; }
.page-search__results .card.is-entering:nth-child(5) { animation-delay: 80ms; }
.page-search__results .card.is-entering:nth-child(n+6) { animation-delay: 100ms; }

[data-static-list] {
  transition: opacity var(--fast) var(--ease);
}
[data-static-list].is-search-hidden {
  display: none;
}

@keyframes search-item-in {
  from {
    opacity: 0;
    transform: translateY(3px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* --------------------------------------------------------------- palette */
/* A dialog is display:none until open, so the layout rules are scoped to [open].
   Setting display on .palette itself would make it visible when closed, the same
   trap as styling a [hidden] element. */

.palette {
  width: min(42rem, calc(100vw - 2rem));
  max-height: min(30rem, calc(100vh - 8rem));
  margin: 12vh auto auto;
  padding: 0;
  border: 1px solid var(--rule-strong);
  border-radius: 2px;
  background: var(--ground);
  color: var(--ink);
  overflow: hidden;
  box-shadow: 0 16px 36px -4px rgb(0 0 0 / 0.35),
              0 6px 16px -2px rgb(0 0 0 / 0.15);
}
@media (max-width: 40rem) {
  .palette {
    width: calc(100vw - 1.5rem);
    max-height: 82dvh;
    margin: 1.5rem auto auto;
  }
}
.palette[open] {
  display: flex;
  flex-direction: column;
  animation: palette-in var(--slow) var(--ease-spring) both;
}
.palette::backdrop {
  background: rgb(8 10 12 / 0.6);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}
.palette[open]::backdrop {
  animation: fade-in var(--slow) var(--ease) both;
}
@keyframes palette-in {
  from {
    opacity: 0;
    transform: translateY(-0.75rem) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.palette__head {
  display: flex;
  align-items: center;
  gap: var(--s3);
  padding: var(--s3) var(--s4);
  border-bottom: 1px solid var(--rule);
}
.palette__input {
  flex: 1 1 auto;
  min-width: 0;
  border: 0;
  background: none;
  font-size: var(--t-body);
  color: var(--ink);
}
.palette__input::placeholder { color: var(--ink-3); }
/* The input is the only text field in a modal dialog and is focused on open, so
   a ring around it is noise. The head rule carries the focus state instead. */
.palette__input:focus-visible { outline: none; }
.palette__head:focus-within { border-bottom-color: var(--accent); }
.palette__close {
  flex: none;
  padding: 0.15rem var(--s2);
  border: 1px solid var(--rule-strong);
  border-radius: 2px;
  background: none;
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-3);
  cursor: pointer;
  transition: color var(--fast) var(--ease),
              background var(--fast) var(--ease),
              border-color var(--fast) var(--ease),
              transform var(--fast) var(--ease);
}
.palette__close:hover {
  color: var(--ink);
  background: var(--sunken);
  border-color: var(--ink-3);
  transform: scale(1.05);
}

.palette__status {
  padding: var(--s2) var(--s4);
  border-bottom: 1px solid var(--rule);
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.palette__list { overflow-y: auto; overscroll-behavior: contain; }
.palette__option {
  position: relative;
  transition: background var(--fast) var(--ease);
}
.palette__option.is-entering {
  animation: search-item-in 130ms var(--ease) both;
}
.palette__option.is-entering:nth-child(1) { animation-delay: 0ms; }
.palette__option.is-entering:nth-child(2) { animation-delay: 15ms; }
.palette__option.is-entering:nth-child(3) { animation-delay: 30ms; }
.palette__option.is-entering:nth-child(4) { animation-delay: 45ms; }
.palette__option.is-entering:nth-child(5) { animation-delay: 60ms; }
.palette__option.is-entering:nth-child(n+6) { animation-delay: 75ms; }
.palette__option + .palette__option { border-top: 1px solid var(--rule); }
.palette__option::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--accent);
  opacity: 0;
  transform: scaleY(0);
  transition: opacity var(--fast) var(--ease), transform var(--fast) var(--ease-out);
}
.palette__option:hover,
.palette__option[aria-selected='true'] {
  background: var(--sunken);
}
.palette__option[aria-selected='true']::before,
.palette__option:hover::before {
  opacity: 1;
  transform: scaleY(1);
}
.palette__link {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--s4);
  align-items: baseline;
  padding: var(--s3) var(--s4);
  color: inherit;
  text-decoration: none;
}
.palette__title {
  font-size: var(--t-small);
  font-weight: 500;
  transition: color var(--fast) var(--ease), transform var(--fast) var(--ease);
}
.palette__option[aria-selected='true'] .palette__title {
  color: var(--accent-ink);
  transform: translateX(2px);
}
.palette__meta {
  font-family: var(--mono);
  font-size: var(--t-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-3);
  white-space: nowrap;
}

@media (max-width: 44rem) {
  .palette {
    width: calc(100vw - 1.25rem);
    max-height: 86dvh;
    margin: 1rem auto auto;
  }
  .palette__head {
    padding: var(--s2) var(--s3);
    gap: var(--s2);
  }
  .palette__status {
    padding: var(--s2) var(--s3);
  }
  .palette__link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: var(--s2) var(--s3);
  }
  .palette__title {
    width: 100%;
    font-size: var(--t-small);
    line-height: 1.35;
    word-break: break-word;
  }
  .palette__meta {
    width: 100%;
    white-space: normal;
    font-size: var(--t-label);
    line-height: 1.3;
    color: var(--ink-3);
  }
}

/* --------------------------------------------------------------- motion */

/* Cross-document transitions. The rail is the one named element, so it is the one
   thing the browser carries across the navigation: it keeps the same element and
   slides it, which it has reason to do because a page with a margin column uses
   the wider shell. Everything else is the root snapshot, and it crosses over.

   Nothing else is named. A named element whose box differs between pages gets
   interpolated between the two, and that movement is visible whichever axis it
   happens on. A cross-fade has no geometry to get wrong.

   Browsers without support navigate normally and lose nothing. */
@view-transition { navigation: auto; }

.rail { view-transition-name: rail; }

@keyframes fade-in { from { opacity: 0; } }
@keyframes fade-out { to { opacity: 0; } }

::view-transition-group(rail) {
  animation-duration: var(--slow);
  animation-timing-function: var(--ease-out);
}
::view-transition-old(root) { animation: fade-out var(--fast) var(--ease) both; }
::view-transition-new(root) { animation: fade-in var(--slow) var(--ease) both; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-delay: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  /* The pseudo-elements are not descendants of the root, so the rule above does
     not reach them. The navigation still happens, as a plain cut. */
  ::view-transition-group(*),
  ::view-transition-old(*),
  ::view-transition-new(*) { animation: none !important; }
}

{% endraw %}
