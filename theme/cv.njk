---
layout: base.njk
permalink: /cv/
title: CV
section: cv
pageDescription: Experience, education and credentials.
---
{% import "cards.njk" as cards %}
{% import "button.njk" as button %}

<div class="page__body">
  <header class="pagehead">
    <p class="pagehead__kicker">Curriculum vitae</p>
    <h1 class="pagehead__title">{{ profile.name }}</h1>
    <p class="pagehead__sub">{{ profile.role }}{% if profile.location %} · {{ profile.location }}{% endif %}</p>
    {#- The rail carries contact details on screen, and print hides the rail. -#}
    {%- if profile.social | length %}
    <p class="printonly contacts">
      {%- for link in profile.social -%}
      {{ link.url | replace("mailto:", "") | replace("https://", "") | replace("http://", "") }}{% if not loop.last %} · {% endif %}
      {%- endfor -%}
    </p>
    {%- endif %}
    <p class="cv-actions">
      {%- if profile.resume %}
      {% call button.link(href=profile.resume, extra="btn--key dither", download=true) %}<span>Download PDF</span>{% endcall %}
      {%- else %}
      {#- No authored file to link to, so Download falls back to the same print
          dialog as Print: "Save as PDF" there is the download. -#}
      {% call button.action(extra="btn--key dither", data="data-print") %}<span>Download PDF</span>{% endcall %}
      {%- endif %}
      {% call button.action(data="data-print") %}<span>Print</span>{% endcall %}
    </p>
    <hr class="pagehead__rule">
  </header>

  {#- The profile summary opens the CV, where a professional summary belongs,
      rather than the home page. -#}
  {%- if profile.summary %}
  <div class="block__head printonly">
    <h2 class="block__title">Summary</h2>
  </div>
  <div class="lede">{{ profile.summary | markdown | safe }}</div>
  {%- endif %}


  {%- if profile.experience | length %}
  <section class="block" id="experience">
    <div class="block__head">
      <h2 class="block__title">Experience</h2>
      <span class="block__aux">{{ profile.experience | length }}</span>
    </div>
    <ol class="cards cards--timeline">
      {%- for job in profile.experience %}{{ cards.experienceRecord(job) }}{% endfor %}
    </ol>
  </section>
  {%- endif %}

  {%- if profile.education | length %}
  <section class="block" id="education">
    <div class="block__head">
      <h2 class="block__title">Education</h2>
      <span class="block__aux">{{ profile.education | length }}</span>
    </div>
    <ol class="cards cards--timeline">
      {%- for school in profile.education %}{{ cards.educationRecord(school) }}{% endfor %}
    </ol>
  </section>
  {%- endif %}

  {#- Publications and projects are taken from pinned_content, in the order it is
      written, because a CV is curated by significance and nothing else in the
      data expresses that: recency would put the newest work first rather than
      the best. Nothing pinned means no section, the same as every other empty
      section here, so the choice is never second guessed. -#}
  {%- set papers = pinned_items | where("collection", "publication") | limit(3) %}
  {%- if papers | length %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Publications</h2>
      <span class="block__aux">{{ cards.aux(papers, stats.collections.publication.total, "/publications/") }}</span>
    </div>
    {{ cards.collection(papers, strip=false) }}
  </section>
  {%- endif %}

  {%- set projects = pinned_items | where("collection", "project") | limit(3) %}
  {%- if projects | length %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Projects</h2>
      <span class="block__aux">{{ cards.aux(projects, stats.collections.project.total, "/projects/") }}</span>
    </div>
    {{ cards.collection(projects, strip=false) }}
  </section>
  {%- endif %}

  {#- Paper only. A tracking system matches keywords, and on screen this would
      only repeat the skills index the rail already links to. The declared
      skills lead, since those are the ones chosen rather than counted, and the
      indexed ones follow without repeating any of them. -#}
  {%- set cvSkills = profile.skills | union(taxonomy.skillNames) | limit(28) %}
  {%- if cvSkills | length %}
  <section class="block printonly">
    <div class="block__head">
      <h2 class="block__title">Skills</h2>
    </div>
    <p class="skills-line">
      {%- for skill in cvSkills -%}
      {{ skill }}{% if not loop.last %}, {% endif %}
      {%- endfor -%}
    </p>
  </section>
  {%- endif %}


  {#- Certifications and awards are separate sections rather than one headed
      Credentials, because an applicant tracking system looks for those words.
      Dates are the display form here, since "Mar 2026" reads as a date to a
      parser and to a person, where the sortable "2026-03" reads as neither. -#}
  {%- set certificates = collections_data.certificate %}
  {%- if certificates | length %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Certifications</h2>
      <span class="block__aux">{{ certificates | length }}</span>
    </div>
    <ol class="cards">
      {%- for item in certificates %}
      {{ cards.line(href=item.permalink, title=item.title, meta=item.dateDisplay,
                secondary=item.issuer, logo=item.logo) }}
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}

  {%- set awards = collections_data.award %}
  {%- if awards | length %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Awards</h2>
      <span class="block__aux">{{ awards | length }}</span>
    </div>
    <ol class="cards">
      {%- for item in awards %}
      {{ cards.line(href=item.permalink, title=item.title, meta=item.dateDisplay,
                secondary=item.issuer, logo=item.logo) }}
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}


  {%- if profile.languages | length %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Languages</h2>
      <span class="block__aux">{{ profile.languages | length }}</span>
    </div>
    <ul class="languages">
      {%- for language in profile.languages %}
      <li class="language">
        <span class="language__name">{{ language.name }}</span>
        <span class="language__level">{{ language.levelLabel }}</span>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
</div>
