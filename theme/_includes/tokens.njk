{%- set currentTheme = themePalettes[site.accent] or themePalettes.blue %}
{%- set accent = currentTheme.accent %}

/* Every colour is measured against its ground. Light: ink >= 16:1, ink-2 >= 7:1,
   ink-3 >= 5:1. Dark: ink >= 13:1, ink-2 >= 7:1, ink-3 >= 5:1. Accent, ground,
   and ink tokens are generated per accent palette with subtle chromatic tints
   (or pure neutral for monochrome) and clear WCAG AAA/AA contrast benchmarks. */

:root {
  color-scheme: light;

  --ground: {{ currentTheme.light.ground }};
  --sunken: {{ currentTheme.light.sunken }};
  --ink: {{ currentTheme.light.ink }};
  --ink-2: {{ currentTheme.light.ink2 }};
  --ink-3: {{ currentTheme.light.ink3 }};
  --rule: {{ currentTheme.light.rule }};
  --rule-strong: {{ currentTheme.light.ruleStrong }};
  --accent: {{ currentTheme.accent.light }};
  --accent-ink: {{ currentTheme.accent.lightInk }};
  --on-accent: {{ currentTheme.light.onAccent }};

  --sans: 'Instrument Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, 'SF Mono', 'Cascadia Mono', 'Roboto Mono', Menlo, monospace;

  --t-display: clamp(2.5rem, 1.5rem + 3.6vw, 3.75rem);
  --t-h1: 1.875rem;
  --t-h2: 1.375rem;
  --t-h3: 1.1875rem;
  --t-body: 1.125rem;
  --t-small: 1rem;
  --t-mono: 0.875rem;
  --t-mono-s: 0.8125rem;
  --t-label: 0.75rem;

  --lh-prose: 1.65;
  --lh-tight: 1.2;
  --lh-ui: 1.45;

  --s1: 0.25rem; --s2: 0.5rem;  --s3: 0.75rem; --s4: 1rem;
  --s5: 1.5rem;  --s6: 2rem;    --s7: 3rem;    --s8: 4rem;  --s9: 6rem;

  --rail-w: 15.5rem;
  --measure: 46rem;
  --aside-w: 12.5rem;
  --gutter: 3rem;
  --pad-x: 1.25rem;
  /* Width of a CV organisation mark, and of the column reserved for it. */
  --mark-w: clamp(3rem, 5vw, 3.625rem);
  --mark-w-list: 2.875rem;
  /* Container caps, sized so the tracks inside actually fill them rather than
     leaving dead space at the right. Widen these two to widen the whole site. */
  --shell: 70rem;
  --shell-wide: 84rem;
  /* Running text stops short of the column so the line stays readable, while
     figures, tables, code and rows use the full width. Held at the paragraph
     width the site already had, so nothing breaks earlier than before; the
     column grew around it rather than the text shrinking into it. */
  --measure-text: 44rem;

  --fast: 140ms;
  --slow: 280ms;
  --ease: cubic-bezier(0.2, 0, 0, 1);
  /* Overshoots slightly, which is what makes a control feel sprung rather than
     merely animated. Used for anything that settles into place. */
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --duration-expand: 320ms;
  /* How far a control travels when pressed. One pixel reads as a press at this
     type size; more reads as a glitch. */
  --press: 1px;
}

/* Dark is a designed counterpart, not an inversion: the ground keeps a blue
   cast, ink stops short of white, and the accent moves up in lightness so it
   stays legible as text. Declared twice so the toggle wins in both directions. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    color-scheme: dark;
    --ground: {{ currentTheme.dark.ground }};
    --sunken: {{ currentTheme.dark.sunken }};
    --ink: {{ currentTheme.dark.ink }};
    --ink-2: {{ currentTheme.dark.ink2 }};
    --ink-3: {{ currentTheme.dark.ink3 }};
    --rule: {{ currentTheme.dark.rule }};
    --rule-strong: {{ currentTheme.dark.ruleStrong }};
    --accent: {{ currentTheme.accent.dark }};
    --accent-ink: {{ currentTheme.accent.darkInk }};
    --on-accent: {{ currentTheme.dark.onAccent }};
  }
  :root:not([data-theme='light']) body { -webkit-font-smoothing: antialiased; }
}
:root[data-theme='dark'] {
  color-scheme: dark;
  --ground: {{ currentTheme.dark.ground }};
  --sunken: {{ currentTheme.dark.sunken }};
  --ink: {{ currentTheme.dark.ink }};
  --ink-2: {{ currentTheme.dark.ink2 }};
  --ink-3: {{ currentTheme.dark.ink3 }};
  --rule: {{ currentTheme.dark.rule }};
  --rule-strong: {{ currentTheme.dark.ruleStrong }};
  --accent: {{ currentTheme.accent.dark }};
  --accent-ink: {{ currentTheme.accent.darkInk }};
  --on-accent: {{ currentTheme.dark.onAccent }};
}
:root[data-theme='dark'] body { -webkit-font-smoothing: antialiased; }

@media (min-width: 60rem) { :root { --pad-x: 2.5rem; } }
