    "dark":   { "ground": "#0e1014", "sunken": "#16181e", "ink": "#d6d8e0", "ink2": "#9aa0ac", "ink3": "#8a909c", "rule": "rgb(214 216 224 / 0.15)", "ruleStrong": "rgb(214 216 224 / 0.3)", "onAccent": "#0e1014" }
