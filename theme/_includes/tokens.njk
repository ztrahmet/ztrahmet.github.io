    "light":  { "ground": "#f6f6f6", "sunken": "#ececec", "ink": "#171717", "ink2": "#4f4f4f", "ink3": "#5f5f5f", "rule": "rgb(23 23 23 / 0.13)", "ruleStrong": "rgb(23 23 23 / 0.26)", "onAccent": "#ffffff" },
    "dark":   { "ground": "#101010", "sunken": "#181818", "ink": "#dcdcdc", "ink2": "#9d9d9d", "ink3": "#8d8d8d", "rule": "rgb(220 220 220 / 0.15)", "ruleStrong": "rgb(220 220 220 / 0.3)", "onAccent": "#101010" }
