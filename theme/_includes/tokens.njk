    "light":  { "ground": "#f5f7f5", "sunken": "#ecefec", "ink": "#141a15", "ink2": "#475649", "ink3": "#58695a", "rule": "rgb(20 26 21 / 0.13)", "ruleStrong": "rgb(20 26 21 / 0.26)", "onAccent": "#ffffff" },
