{#- A mounted organisation mark. Renders nothing without a logo, and handles a
    themed pair or a single asset, so callers never repeat that test.

    An SVG is inlined rather than linked, so a file drawn with currentColor takes
    the theme colour. Anything else falls back to an image. -#}
{% macro asset(src) %}
{%- set svg = src | inlineSvg %}
{%- if svg %}{{ svg | safe }}
{%- else %}<img src="{{ src }}" alt="" loading="lazy" decoding="async">
{%- endif %}
{% endmacro %}

{#- A light/dark pair or a single asset, resolved to markup with no wrapper.
    mark() below is this mounted in the small bordered tile every organisation
    mark on the site sits in; a caller that wants the asset on its own terms,
    such as a grid card's cover or the masthead avatar, uses this directly. -#}
{% macro themed(src) %}
{%- if src.light %}
<span class="light-only">{{ asset(src.light) }}</span>
<span class="dark-only">{{ asset(src.dark) }}</span>
{%- else %}
{{ asset(src) }}
{%- endif %}
{% endmacro %}

{% macro mark(logo) %}
{%- if logo %}
<span class="mark">{{ themed(logo) }}</span>
{%- endif %}
{% endmacro %}
