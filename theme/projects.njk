---
layout: base.njk
permalink: /projects/
title: Projects
section: projects
pageDescription: Projects.
---
{% import "cards.njk" as cards %}
{% import "pagehead.njk" as pagehead %}
{% set items = all_content | where("collection", "project") %}
{% set pinnedProjects = items | where("isPinned", true) %}
{% set otherProjects = items | whereNot("isPinned", true) %}
{% set filterCollection = "project" %}
{% set placeholder = "Filter projects…" %}

<div class="page__body">
  {{ pagehead.simple("Projects") }}

  {%- include "searchbox.njk" %}

  {%- if items | length %}
  <div data-static-list>
    {%- if pinnedProjects | length %}
    <section class="block block--flush">
      <div class="block__head">
        <h2 class="block__title">Pinned</h2>
        <span class="block__aux">{{ pinnedProjects | length }}</span>
      </div>
      {{ cards.collection(pinnedProjects, "pinned") }}
    </section>
    {%- endif %}

    {%- if otherProjects | length %}
    <section class="block{% if not (pinnedProjects | length) %} block--flush{% endif %}">
      <div class="block__head">
        <h2 class="block__title">All projects</h2>
        <span class="block__aux">{{ otherProjects | length }}</span>
      </div>
      {{ cards.collection(otherProjects) }}
    </section>
    {%- endif %}
  </div>
  {%- else %}
  <p class="empty">Nothing published yet.</p>
  {%- endif %}
</div>
