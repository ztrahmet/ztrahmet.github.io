---
layout: base.njk
permalink: /search/
title: Search
section: search
pageDescription: Everything on this site, grouped by type.
---
{% import "cards.njk" as cards %}
{% import "pagehead.njk" as pagehead %}
{%- set everythingSub %}{{ stats.totalItems }} entries across {{ collection_types | length }} collections.
      Press <kbd class="key">/</kbd> anywhere for the search palette.{% endset %}
<div class="page__body">
  {{ pagehead.simple("Everything", sub=everythingSub) }}

  {#- Grouped from the engine's collection registry, so a new collection type
      would appear here without this page being edited. -#}
  {%- for type in collection_types %}
  {%- if type.hasItems %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">{{ type.labelPlural }}</h2>
      <span class="block__aux">{{ type.count }}</span>
    </div>
    <ol class="cards">
      {%- for item in all_content %}
        {%- if item.collection == type.name %}{{ cards.compact(item) }}{% endif %}
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}
  {%- endfor %}
</div>
