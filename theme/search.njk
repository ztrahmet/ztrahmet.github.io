---
layout: base.njk
permalink: /search/
title: Search
section: search
pageDescription: Everything on this site, grouped by type.
---
{% import "rows.njk" as r %}
<div class="page__body">
  <header class="pagehead">
    <p class="pagehead__kicker">Index</p>
    <h1 class="pagehead__title">Everything</h1>
    <p class="pagehead__sub">
      {{ stats.totalItems }} entries across {{ collection_types | length }} collections.
      Press <kbd class="key">/</kbd> anywhere for the search palette.
    </p>
    <hr class="pagehead__rule">
  </header>

  {#- Grouped from the engine's collection registry, so a new collection type
      would appear here without this page being edited. -#}
  {%- for type in collection_types %}
  {%- if type.hasItems %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">{{ type.labelPlural }}</h2>
      <span class="block__aux">{{ type.count }}</span>
    </div>
    <ol class="rows">
      {%- for item in all_content %}
        {%- if item.collection == type.name %}{{ r.row(item) }}{% endif %}
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}
  {%- endfor %}
</div>
