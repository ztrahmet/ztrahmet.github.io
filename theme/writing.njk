---
layout: base.njk
permalink: /writing/
title: Writing
section: writing
pageDescription: Posts and publications.
---
{% import "hub.njk" as hub %}

{#- Blog and publications, which is every collection the other two hubs do not claim. -#}
{% set items = all_content | whereNot("collection", "project") | whereNot("collection", "certificate") | whereNot("collection", "award") %}

<div class="page__body">
  <header class="pagehead">
    <p class="pagehead__kicker">Index</p>
    <h1 class="pagehead__title">Writing</h1>
    <hr class="pagehead__rule">
  </header>

  {%- if items | length %}
  <section class="block block--flush">
    <div class="block__head">
      <h2 class="block__title">All entries</h2>
      <span class="block__aux">{{ items | length }}</span>
    </div>
    {{ hub.index(items) }}
  </section>
  {%- else %}
  <p class="empty">Nothing published yet.</p>
  {%- endif %}
</div>
