---
pagination:
  data: collections.all_content
  size: 1
  alias: entry
permalink: "{{ entry.permalink }}"
layout: base.njk
pageClass: page--split
eleventyComputed:
  title: "{{ entry.title }}"
  pageDescription: "{{ entry.seo.description }}"
  ogType: "{{ entry.seo.ogType }}"
  shareImage: "{{ entry.seo.image }}"
  hasMath: "{% if 'katex' in entry.html %}1{% endif %}"
  publishedIso: "{{ entry.seo.publishedIso }}"
  section: "{% for hub in nav %}{% if entry.collection in hub.collections %}{{ hub.id }}{% endif %}{% endfor %}"
---
{% import "cards.njk" as cards %}
{% import "mark.njk" as m %}
{% import "icons.njk" as i %}
{% import "button.njk" as button %}

<div class="page__body">
  <article class="entry">
    <header class="pagehead">
      <p class="pagehead__kicker">
        {{- entry.collection | collectionLabel(false) -}}
        {%- if entry.isOngoing %}<span class="dot" aria-hidden="true"></span>Ongoing{% endif -%}
      </p>
      {#- The mark shares the row with the title and issuer, as on a CV record. -#}
      <div class="pagehead__head">
        <div class="pagehead__id">
          <h1 class="pagehead__title">{{ entry.title }}</h1>
          {%- if entry.subtitle %}
          <p class="pagehead__sub">{{ entry.subtitle }}</p>
          {%- endif %}
          {#- Authors belong under the title, the way a citation reads. -#}
          {%- if entry.authors | length %}
          <p class="pagehead__byline">{{ entry.authors | join(", ") }}</p>
          {%- endif %}
          {#- The external destinations are what an entry is for, so they sit with
              the title rather than after the body. A credential with no body would
              otherwise put its verification link at the foot of an empty page. -#}
          {%- if entry.url or entry.repository %}
          <p class="pagehead__links">
            {%- if entry.url %}
            {% call button.link(href=entry.url, extra="btn--out", rel="noopener") %}<span>{{ entry.url | replace("https://", "") | replace("http://", "") }}</span>{{ i.ui("external") }}{% endcall %}
            {%- endif %}
            {%- if entry.repository %}
            {% call button.link(href=entry.repository, extra="btn--out", rel="noopener") %}<span>Repository</span>{{ i.ui("external") }}{% endcall %}
            {%- endif %}
          </p>
          {%- endif %}
        </div>
        {{ m.mark(entry.logo) }}
      </div>
      <hr class="pagehead__rule">
    </header>

    {%- if entry.image %}
    {#- The cover is above the fold, so it is never lazy loaded. -#}
    <figure class="figure">
      {%- if entry.image.light %}
      <img class="light-only" src="{{ entry.image.light }}" alt="Cover image for {{ entry.title }}" decoding="async">
      <img class="dark-only" src="{{ entry.image.dark }}" alt="Cover image for {{ entry.title }}" decoding="async">
      {%- else %}
      <img src="{{ entry.image }}" alt="Cover image for {{ entry.title }}" decoding="async">
      {%- endif %}
      <figcaption><span class="figure__text">{{ entry.collection | collectionLabel(false) }} cover</span></figcaption>
    </figure>
    {%- endif %}

    {%- if entry.description %}
    <p class="lede">{{ entry.description }}</p>
    {%- endif %}

    {%- if entry.hasMarkdown %}
    <div class="prose">{{ entry.html | inlineThemedSvg(entry.baseDir) | safe }}</div>
    {%- endif %}

  </article>

  {%- if entry.newer or entry.older %}
  <nav class="adjacent" aria-label="Adjacent entries">
    {%- if entry.older %}
    {% call button.link(href=entry.older.permalink, extra="btn--back adjacent__link") %}
      {{ i.ui("left") }}
      <span class="adjacent__text">
        <span class="adjacent__dir">Older</span>
        <span class="adjacent__title">{{ entry.older.title }}</span>
      </span>
    {% endcall %}
    {%- endif %}
    {%- if entry.newer %}
    {% call button.link(href=entry.newer.permalink, extra="adjacent__link adjacent__link--next") %}
      <span class="adjacent__text">
        <span class="adjacent__dir">Newer</span>
        <span class="adjacent__title">{{ entry.newer.title }}</span>
      </span>
      {{ i.ui("right") }}
    {% endcall %}
    {%- endif %}
  </nav>
  {%- endif %}

  {%- if entry.related | length %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Related</h2>
      <span class="block__aux">{{ entry.related | length }}</span>
    </div>
    <ol class="cards">
      {%- for item in entry.related %}
      {{ cards.line(
        href=item.permalink,
        title=item.title,
        meta=item.date,
        tag=item.collection | collectionLabel(false),
        secondary=item.description,
        logo=item.logo,
        ongoing=item.isOngoing
      ) }}
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}
</div>

<aside class="page__aside">
  <div class="aside__block">
    <p class="aside__label">Details</p>
    <dl class="aside__list">
      <div class="aside__row">
        <dt>Date</dt>
        <dd><time datetime="{{ entry.primaryDate }}">{{ entry.dateDisplay }}</time></dd>
      </div>
      {%- if entry.collection == 'project' %}
      <div class="aside__row">
        <dt>Period</dt>
        <dd>{{ entry.startDisplay }} – {% if entry.isOngoing %}Present{% else %}{{ entry.endDisplay }}{% endif %}</dd>
      </div>
      {%- endif %}
      {%- if entry.credential_id %}
      <div class="aside__row">
        <dt>Credential</dt>
        <dd class="is-mono">{{ entry.credential_id }}</dd>
      </div>
      {%- endif %}
      {%- if entry.expiresDisplay %}
      <div class="aside__row">
        <dt>Expires</dt>
        <dd>{{ entry.expiresDisplay }}{% if entry.isExpired %} <span class="flag">Expired</span>{% endif %}</dd>
      </div>
      {%- endif %}
      {%- if entry.hasMarkdown %}
      <div class="aside__row">
        <dt>Reading</dt>
        <dd>{{ entry.readingTime }} min · {{ entry.wordCount }} words</dd>
      </div>
      {%- endif %}
    </dl>
  </div>

  {%- if entry.toc | length %}
  {#- The reading rail. Without JS this is an ordinary table of contents; the
      script adds the progress fill and tracks the section being read. -#}
  <nav class="aside__block" aria-labelledby="toc-label" data-reading>
    <p class="aside__label" id="toc-label">Contents</p>
    <div class="toc">
      <span class="toc__fill" aria-hidden="true"></span>
      <ol class="toc__list">
        {%- for heading in entry.toc %}
        <li class="toc__item toc__item--l{{ heading.level }}">
          <a href="#{{ heading.id }}">{{ heading.text }}</a>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </nav>
  {%- endif %}

  {%- if entry.skills | length %}
  <div class="aside__block">
    <p class="aside__label">Skills</p>
    <ul class="tags">
      {%- for skill in entry.skills %}
      <li><a href="/skills/{{ skill | slugify }}/">{{ skill }}</a></li>
      {%- endfor %}
    </ul>
  </div>
  {%- endif %}
</aside>
