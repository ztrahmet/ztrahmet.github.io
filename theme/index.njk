---
layout: base.njk
section: home
---
{% import "rows.njk" as r %}
{% import "mark.njk" as m %}

<div class="page__body">
  <header class="masthead">
    <div class="masthead__head">
      <div class="masthead__id">
        <h1 class="masthead__name">{{ profile.name }}</h1>
        <p class="masthead__role">{{ profile.role }}</p>
      </div>
      {%- if profile.avatar %}
      <span class="masthead__avatar">
        {%- if profile.avatar.light %}
        <span class="light-only">{{ m.asset(profile.avatar.light) }}</span>
        <span class="dark-only">{{ m.asset(profile.avatar.dark) }}</span>
        {%- else %}
        {{ m.asset(profile.avatar) }}
        {%- endif %}
      </span>
      {%- endif %}
    </div>
    <hr class="masthead__rule">
  </header>

  {%- if pinned_items | length %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Selected</h2>
      <span class="block__aux">{{ pinned_items | length }}</span>
    </div>
    <ol class="rows">
      {%- for item in pinned_items %}{{ r.row(item) }}{% endfor %}
    </ol>
  </section>
  {%- endif %}

  {%- if all_content | length %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Recent</h2>
      <span class="block__aux"><a href="/search/">All {{ stats.totalItems }}</a></span>
    </div>
    <ol class="rows">
      {%- for item in all_content | byDate | limit(6) %}{{ r.row(item) }}{% endfor %}
    </ol>
  </section>
  {%- endif %}
</div>
