---
layout: base.njk
section: home
---
{% import "cards.njk" as cards %}
{% import "mark.njk" as m %}

<div class="page__body">
  <header class="masthead">
    <div class="masthead__head">
      <div class="masthead__id">
        <h1 class="masthead__name">{{ profile.name }}</h1>
        <p class="masthead__role">{{ profile.role }}</p>
      </div>
      {%- if profile.avatar %}
      <span class="masthead__avatar">{{ m.themed(profile.avatar) }}</span>
      {%- endif %}
    </div>
    <hr class="masthead__rule">
  </header>

  {%- if all_content | length %}
  {%- set recent = all_content | byDate | limit(5) %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Recent</h2>
      <span class="block__aux">{{ cards.aux(recent, stats.totalItems, "/search/") }}</span>
    </div>
    {{ cards.collection(recent, "compact") }}
  </section>
  {%- endif %}

  {%- if pinned_items | length %}
  <section class="block">
    <div class="block__head">
      <h2 class="block__title">Selected</h2>
      <span class="block__aux">{{ pinned_items | length }}</span>
    </div>
    {#- Compact throughout, forced rather than left to each collection's
        default: pinned work and recent posts sit side by side here and read
        as one list, not as several defaults collided together. -#}
    {{ cards.collection(pinned_items, "compact") }}
  </section>
  {%- endif %}
</div>
